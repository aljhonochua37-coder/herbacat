rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        getUserData().get('role', '') == 'admin' ||
        getUserData().get('role', '') == 'administrator'
      );
    }

    // 1. User Profiles & Roles
    match /users/{userId} {
      // Users can read their own profile; Admins can read all user profiles
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their profile during sign up with role != 'admin'
      allow create: if isOwner(userId) &&
                       request.resource.data.get('role', 'user') != 'admin' &&
                       request.resource.data.get('role', 'user') != 'administrator';

      // Users can update their profile (e.g. name, municipality, favorites), but CANNOT elevate their role
      allow update: if isOwner(userId) &&
                       request.resource.data.get('role', resource.data.get('role', 'user')) == resource.data.get('role', 'user');

      // Only Admins can modify roles or delete users
      allow delete, update: if isAdmin();

      // User favorites subcollection (alternative to array field)
      match /favorites/{herbId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Herbs Collection (and plants alias)
    match /herbs/{herbId} {
      // Everyone can read herbs
      allow read: if true;

      // Only users with role == 'admin' can create, update, or delete herbs
      allow create, update, delete: if isAdmin();
    }

    match /plants/{plantId} {
      // Botanical archive backward compatibility
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 3. Recipes / Preparation Guides Collection
    match /recipes/{recipeId} {
      // Everyone can read recipes
      allow read: if true;

      // Only users with role == 'admin' can create, update, or delete recipes
      allow create, update, delete: if isAdmin();
    }

    // 4. Orders Collection
    match /orders/{orderId} {
      // Users can only view their own orders; Admins can view all orders
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      // Authenticated users can create their own order with matching userId
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

      // Admins can update any order (e.g. status updater: pending -> shipped -> delivered)
      // Users can only update their own order if it's pending (e.g. cancel)
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid
      );

      // Only admins can delete orders
      allow delete: if isAdmin();
    }
  }
}
